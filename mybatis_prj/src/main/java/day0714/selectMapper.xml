<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="day0715">
	<!-- 컬럼하나 한행 조회 
		 dept테이블에서 입력된 부서번호가 해당하는 
		 부서의 부서명 (varchar2 => resultType=String) 검색 -->
	<select id="scsr" parameterType="int" resultType="String">
		select	dname
		from	dept
		where	deptno=#{ deptno }
	</select>
	<!-- 컬럼여러개 한행 조회 
		 emp테이블에서 입력받은 사원번호에 해당하는 사원에 
		 사원명, 직무, 매니저번호, 입사일, 연봉, 보너스, 부서번호 -->
	<select id="mcsr" parameterType="int" resultType="empDomain">
		SELECT	EMPNO, ENAME, JOB, MGR, HIREDATE, SAL, COMM, DEPTNO 
		FROM	EMP 
		WHERE	EMPNO = #{ empno }
	</select>
