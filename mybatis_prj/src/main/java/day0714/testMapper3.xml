<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="day0715">
	<!--  입력값 없이 insert를 수행하면 parametertype의 속성이 필요없다
			news 테이블에서 시퀀스를 사용한 번호와 입력일 추가  -->
  <insert id="insertNotParameter">
  	INSERT INTO news(num, subject, input_date)
	values (seq_board.nextval, '테스트', sysdate)
  </insert>
  <!-- 입력값이 단일형일때 insert ${}를 사용 하게 되면 쿼리문에 값이 입력된다.(위험하다)
  		#{}을 권장한다. -->
  <insert id="insertPrimitiveParameter" parameterType="int">
  	INSERT INTO news(num)
	values (#{ num })
  </insert>
  <!-- 입력값이 DTO일때 insert ${}를 사용 하게 되면 쿼리문에 값이 입력된다.(위험하다)
  		#{}을 권장한다. -->
  <insert id="insertDTOParameter" parameterType="day0715.NewsDTO">
  	INSERT INTO news(num, subject, content, writer,input_date)
	values (seq_board.nextval, #{ subject },#{newsContent},#{writer},sysdate)
  </insert>
  <!-- update 번호 제목 내용 작성자를 입력 받아서 News테이블에 해당 번호에 따른 레코드를 변경 -->
  <update id="updateNews" parameterType="day0715.NewsDTO">
  	update News
  	set subject = #{ subject }, content = #{ newsContent }, writer = #{ writer }
  	where num = #{ num }
  </update>
  
  <delete id="deleteNews" parameterType="day0715.NewsDTO">
  	delete from news
  	where num = #{num}
  </delete>
</mapper>