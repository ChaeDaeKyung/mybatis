<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
	<properties resource="properties/database.properties"/>
	<typeAliases>
		<typeAlias type="kr.co.sist.emp.EmpDomain" alias="empDomain"/>
		<typeAlias type="day0721.BoardDomain" alias="boardDomain"/>
		<typeAlias type="day0721.CarDomain" alias="carDomain"/>
		<typeAlias type="day0714.CpDept" alias="cpDeptDomain"/>
		<typeAlias type="day0714.CpDept" alias="cpDeptDTO"/>
		<typeAlias type="kr.co.sist.board.BoardDomain" alias="boardDomain2"/>
		<typeAlias type="kr.co.sist.board.BoardDomain" alias="boardDTO"/>
		<typeAlias type="kr.co.sist.board.RangeDTO" alias="rangeDTO"/>
		<typeAlias type="day0723.WebMemberDomain" alias="webMemberDomain"/>
		<typeAlias type="day0723.WebMemberDTO" alias="webMemberDTO"/>
		<typeAlias type="day0723.TransactionDTO" alias="transactionDTO"/>
	</typeAliases>
	<environments default="development">
		<environment id="development">
			<transactionManager type="JDBC"/>
			<dataSource type="POOLED">
				<!--  <property name="driver" value="oracle.jdbc.OracleDriver"/>oracle.jdbc.OracleDriver
				<property name="url" value="jdbc:oracle:thin:@localhost:1521:orcl"/>jdbc:oracle:thin:@localhost:1521:orcl
				<property name="username" value="scott"/>계정명
				<property name="password" value="tiger"/>비밀번호 -->
				<property name="driver" value="${driver}"/>
				<property name="url" value="${url}"/>
				<property name="username" value="${username}"/>
				<property name="password" value="${password}"/>
			</dataSource>
		</environment>
	</environments>
	<mappers>
		<mapper resource="day0714/testMapper.xml"/>
		<mapper resource="day0714/testMapper2.xml"/>
		<mapper resource="day0714/testMapper3.xml"/>
		<mapper resource="day0714/selectMapper.xml"/>
		<mapper resource="day0716/selectMapper2.xml"/>
		<mapper resource="day0720/selectMapper3.xml"/>
		<mapper resource="day0721/selectMapper4.xml"/>
		<mapper resource="day0722/selectMapper5.xml"/>
		<mapper resource="day0723/selectMapper6.xml"/>
		<!-- 게시판 -->
		<mapper resource="kr/co/sist/board/boardMapper.xml"/>
	</mappers>
</configuration>